# Copy to .env and edit if needed. Defaults work with scripts/start_llm.ps1.

# Any OpenAI-compatible server: llama.cpp (default), OpenVINO Model Server, or vLLM later.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b-instruct
LLM_API_KEY=local
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=200

# STT: Parakeet TDT 0.6B v2 (English) via onnx-asr. int8 is faster on CPU.
STT_MODEL=nemo-parakeet-tdt-0.6b-v2
STT_QUANTIZATION=int8

# TTS: Kokoro voice. af_heart = female, best quality.
TTS_VOICE=af_heart
TTS_SPEED=1.05

# VAD silence (seconds) before the smart-turn model is asked "is the user done?"
VAD_STOP_SECS=0.2

HOST=127.0.0.1
PORT=7860
LOG_DIR=logs
